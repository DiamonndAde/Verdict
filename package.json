{
  "name": "verdict",
  "private": true,
  "version": "0.1.0",
  "description": "Challenge a friend, settle by cryptographic proof. 1v1 sports wagers settled trustlessly against TxLINE Merkle-proven match data on Solana.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "//engines": "Node 24+ is required by the test suite: litesvm 0.8.0's native addon aborts with std::bad_alloc on repeated BPF execution under Node 20/22.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "tsx --test tests/verdict.test.ts",
    "setup-wallets": "tsx scripts/setup-wallets.ts",
    "setup-dusdc": "tsx scripts/setup-dusdc.ts",
    "find-fixture": "tsx scripts/find-fixture.ts",
    "record-proofs": "tsx scripts/record-proofs.ts",
    "dump-oracle-state": "tsx scripts/dump-oracle-state.ts",
    "measure-settle": "tsx scripts/measure-settle.ts",
    "measure-cu": "tsx scripts/measure-cu.ts",
    "demo": "tsx scripts/demo.ts",
    "find-upcoming": "tsx scripts/find-upcoming.ts",
    "watch-live": "tsx scripts/watch-live.ts",
    "live-create-check": "tsx scripts/live-create-check.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@solana/spl-token": "^0.4.15",
    "@types/node": "^22.13.4",
    "bn.js": "^5.2.5",
    "litesvm": "^0.8.0",
    "playwright": "^1.61.1",
    "tsx": "^4.23.0",
    "typescript": "^5.7.3"
  }
}
